{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "globalEnv": [
    "NEXTAUTH_URL",
    "GOOGLE_CLIENT_ID",
    "GOOGLE_CLIENT_SECRET",
    "NEXTAUTH_SECRET",
    "DATABASE_URL",
    "NODE_ENV",
    "JAAS_APP_ID",
    "JAAS_API_SECRET",
    "JAAS_KEY_ID",
    "NEXT_PUBLIC_JAAS_APP_ID",
    "NEXT_PUBLIC_JAAS_API_SECRET",
    "NEXT_PUBLIC_WS_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**",
        "src/generated/**",
        "packages/db/src/generated/**"
      ],
      "env": [
        "JAAS_APP_ID",
        "JAAS_API_SECRET",
        "JAAS_KEY_ID",
        "NEXT_PUBLIC_JAAS_APP_ID",
        "NEXT_PUBLIC_JAAS_API_SECRET",
        "NEXT_PUBLIC_WS_URL"
      ]
    },
    "lint": {
      "dependsOn": ["^lint"],
      "env": [
        "JAAS_APP_ID",
        "JAAS_API_SECRET",
        "JAAS_KEY_ID",
        "NEXT_PUBLIC_JAAS_APP_ID",
        "NEXT_PUBLIC_JAAS_API_SECRET",
        "NEXT_PUBLIC_WS_URL"
      ]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "copy:prisma": {
      "cache": false
    }
  }
}
